{
  "manifest_version": 3,
  "name": "SatyLens",
  "version": "1.6.0",
  "description": "Capture. Record. Share. Screenshots and screen recordings straight from Chrome.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "clipboardWrite",
    "downloads",
    "notifications",
    "desktopCapture",
    "tabCapture",
    "identity"
  ],
  "oauth2": {
    "client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "commands": {
    "capture-visible-tab": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Capture visible tab screenshot"
    },
    "toggle-recording": {
      "suggested_key": { "default": "Ctrl+Shift+R", "mac": "Command+Shift+R" },
      "description": "Start or stop screen recording"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["selector/selector.js"],
      "css": ["selector/selector.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["recorder/recorder.html", "gallery/gallery.html", "editor/editor.html"],
      "matches": ["<all_urls>"]
    }
  ]
}

