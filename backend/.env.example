# Copy this file to .env and fill in real values. NEVER commit .env.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service-role key (Project Settings -> API -> service_role).
# This key bypasses Row Level Security — it must ONLY ever live here,
# in the backend's environment. Never send it to the extension/browser.
# The backend uses it server-side to generate short-lived, single-object
# signed upload/read URLs for the browser — the key itself never leaves
# this process. See supabase/SETUP.md for the full explanation.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this backend once deployed, used to build share links
# like https://api.yourdomain.com/s/abc123. No trailing slash.
#
# On Render specifically, leave this at the localhost default: the backend
# auto-detects its real https://*.onrender.com URL from Render's own
# RENDER_EXTERNAL_URL variable and share links work immediately. Only set
# this explicitly if you're pointing a custom domain at the service, or
# deploying somewhere that doesn't provide an equivalent auto-detected URL.
PUBLIC_BASE_URL=http://localhost:8000

# Maximum upload size, in megabytes, for the LEGACY POST /api/upload
# endpoint only (kept for backward compatibility -- the extension itself
# no longer calls it). 0 = no cap (the default). The current upload flow
# the extension actually uses (POST /api/upload/signed-url) uploads
# directly from the browser to storage and has no size ceiling of its
# own regardless of this setting.
MAX_FILE_SIZE_MB=0

# If set to a positive number, every NEW share automatically gets an
# expiration this many days out, applied at upload time -- an org-wide
# retention policy, not a per-user opt-in. 0 (default) = no forced
# default; users can still set their own per-share expiration in the
# extension either way.
DEFAULT_SHARE_EXPIRY_DAYS=0

# Signs short-lived download tokens for password-protected shares (lets
# someone who already entered the password download the file without
# re-entering it). Auto-generates a random one per process if left
# blank, which is fine for local development but means any in-flight
# password-protected download links break across a restart -- set this
# explicitly to a random string before deploying anywhere persistent.
SHARE_TOKEN_SECRET=

# How long a signed READ url for a Supabase-hosted file stays valid, in
# seconds. Regenerated fresh every time someone loads a share page (never
# cached/stored), so this only needs to comfortably cover one viewing
# session, not the share link's overall lifetime.
SUPABASE_PRESIGNED_DOWNLOAD_EXPIRY=3600

# Comma-separated list of extra allowed CORS origins beyond the extension
# origin(s) below. Leave blank for none.
EXTRA_CORS_ORIGINS=

# Comma-separated chrome-extension:// origins allowed to call this API.
# Find your extension's ID at chrome://extensions after loading it unpacked.
ALLOWED_EXTENSION_ORIGINS=chrome-extension://YOUR_EXTENSION_ID_HERE

# Supabase storage bucket name used for capture files. Must exactly match
# a bucket that actually exists in your Supabase project (case-sensitive)
# -- a mismatch here is one of the most common causes of upload failures.
# Leave the bucket set to Private; see supabase/SETUP.md for why that's
# both fine and recommended with the current signed-URL upload/view flow.
SUPABASE_BUCKET=captures

# Optional shared token gating the /api/analytics/* reporting + dashboard
# endpoints (GET /dashboard fetches use this too). Leave blank for open
# access during local development; set a random string before deploying
# anywhere public. Ingestion (/api/events, /api/session/*) never needs this.
ANALYTICS_DASHBOARD_TOKEN=

# Cloudflare R2 (S3-compatible) — a third "Create Share Link" destination
# alongside the Supabase backend and Google Drive. All optional: leave
# blank and the R2 endpoints just return a clean 503 until configured.
# NEVER put R2_SECRET_ACCESS_KEY anywhere but here. See R2_SETUP.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Usually leave this blank — it's derived from R2_ACCOUNT_ID. Only set it
# if you're using a custom S3-compatible endpoint.
R2_ENDPOINT=
# How long a presigned PUT (upload) URL stays valid, in seconds. 24 hours
# by default -- generous enough for a very large recording even on a
# slow or interrupted connection, and well within S3-compatible presigned
# URLs' own protocol maximum (7 days for SigV4).
R2_PRESIGNED_UPLOAD_EXPIRY=86400
# How long a presigned GET (viewer/download) URL stays valid, in seconds.
R2_PRESIGNED_DOWNLOAD_EXPIRY=3600
