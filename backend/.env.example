# Copy this file to .env and fill in real values. NEVER commit .env.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service-role key (Project Settings -> API -> service_role).
# This key bypasses Row Level Security — it must ONLY ever live here,
# in the backend's environment. Never send it to the extension/browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this backend once deployed, used to build share links
# like https://api.yourdomain.com/s/abc123. No trailing slash.
#
# On Render specifically, leave this at the localhost default: the backend
# auto-detects its real https://*.onrender.com URL from Render's own
# RENDER_EXTERNAL_URL variable and share links work immediately. Only set
# this explicitly if you're pointing a custom domain at the service, or
# deploying somewhere that doesn't provide an equivalent auto-detected URL.
PUBLIC_BASE_URL=http://localhost:8000

# Maximum upload size accepted by POST /api/upload, in megabytes.
MAX_FILE_SIZE_MB=100

# Comma-separated list of extra allowed CORS origins beyond the extension
# origin(s) below. Leave blank for none.
EXTRA_CORS_ORIGINS=

# Comma-separated chrome-extension:// origins allowed to call this API.
# Find your extension's ID at chrome://extensions after loading it unpacked.
ALLOWED_EXTENSION_ORIGINS=chrome-extension://YOUR_EXTENSION_ID_HERE

# Supabase storage bucket name used for capture files.
SUPABASE_BUCKET=captures

# Optional shared token gating the /api/analytics/* reporting + dashboard
# endpoints (GET /dashboard fetches use this too). Leave blank for open
# access during local development; set a random string before deploying
# anywhere public. Ingestion (/api/events, /api/session/*) never needs this.
ANALYTICS_DASHBOARD_TOKEN=

# Cloudflare R2 (S3-compatible) — a third "Create Share Link" destination
# alongside the Supabase backend and Google Drive. All optional: leave
# blank and the R2 endpoints just return a clean 503 until configured.
# NEVER put R2_SECRET_ACCESS_KEY anywhere but here. See R2_SETUP.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Usually leave this blank — it's derived from R2_ACCOUNT_ID. Only set it
# if you're using a custom S3-compatible endpoint.
R2_ENDPOINT=
# How long a presigned PUT (upload) URL stays valid, in seconds.
R2_PRESIGNED_UPLOAD_EXPIRY=900
# How long a presigned GET (viewer/download) URL stays valid, in seconds.
R2_PRESIGNED_DOWNLOAD_EXPIRY=3600
